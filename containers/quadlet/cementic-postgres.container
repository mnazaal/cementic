# cementic Postgres (pgvector + vectorscale) as a persistent Podman Quadlet
# service, instead of starting/stopping the container by hand.
#
# One-time setup:
#
#   1. Build the image once (same image compose.yml builds):
#        podman build -f containers/postgres-vectorscale/Containerfile \
#          -t cementic-postgres-vectorscale:latest .
#      (or: podman compose build)
#
#   2. Install this unit for your user (copy or symlink):
#        mkdir -p ~/.config/containers/systemd
#        ln -s "$(pwd)/containers/quadlet/cementic-postgres.container" \
#          ~/.config/containers/systemd/cementic-postgres.container
#
#   3. This file MUST exist before first start, even if you don't want any
#      overrides. On Podman 4.9.3, Quadlet's EnvironmentFile= does not honor
#      the "-" (ignore-if-missing) prefix the way systemd's own directive
#      does — it doesn't even strip the "-" from the value, so a leading "-"
#      corrupts the path entirely (Quadlet's relative-path resolution kicks
#      in on the non-"/"-prefixed string and prepends the *unit file's own
#      directory*, producing garbage like ".../containers/systemd/-/home/...").
#      This unit therefore uses a plain, required, unconditional path below.
#      Always create the file first:
#        mkdir -p ~/.config/cementic
#        touch ~/.config/cementic/postgres.env
#      To override credentials/db name, put them in that file instead:
#        cat > ~/.config/cementic/postgres.env <<'EOF'
#        POSTGRES_USER=cementic
#        POSTGRES_PASSWORD=change-me
#        POSTGRES_DB=cementic
#        EOF
#        chmod 600 ~/.config/cementic/postgres.env
#
#   4. Activate:
#        systemctl --user daemon-reload
#        systemctl --user start cementic-postgres.service
#
#      Do not run `systemctl --user enable` on this unit — Quadlet-generated
#      units are transient/generated, and `enable` fails on them with "Unit
#      ... is transient or generated". The [Install] section above is
#      processed by Quadlet itself at daemon-reload time, so the unit is
#      already wired to start whenever default.target is reached (e.g. next
#      login) with no separate enable step.
#
#      To have it survive full logout / start at boot without an active
#      login session: loginctl enable-linger "$USER"
#
# Note: PublishPort below is a Quadlet directive resolved at daemon-reload
# time, not a container env var — unlike compose.yml's CEMENTIC_DB_PORT, it
# is not overridable via environment. Edit PublishPort= directly here and
# re-run `systemctl --user daemon-reload` if you need a non-default port.
#
# See README.md, "Running Postgres as a persistent service".

[Unit]
Description=cementic Postgres (pgvector + vectorscale)
After=network-online.target

[Container]
Image=localhost/cementic-postgres-vectorscale:latest
ContainerName=cementic-postgres
Pull=never
Environment=POSTGRES_USER=cementic
Environment=POSTGRES_PASSWORD=cementic
Environment=POSTGRES_DB=cementic
EnvironmentFile=%h/.config/cementic/postgres.env
PublishPort=127.0.0.1:5432:5432
# Postgres 18's image manages its own major-version subdirectory under
# /var/lib/postgresql — mounting a volume at .../data directly conflicts
# with that scheme, so the volume must cover the parent dir.
Volume=cementic-postgres-data:/var/lib/postgresql
HealthCmd=pg_isready -U cementic
HealthInterval=2s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=10s

[Service]
Restart=on-failure
TimeoutStartSec=60

[Install]
WantedBy=default.target
