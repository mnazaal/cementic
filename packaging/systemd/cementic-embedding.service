# llama.cpp embedding server on the Intel iGPU, as a systemd *user* service.
#
# cementic identifies its embedding server only by the model id at /v1/models,
# so any OpenAI-compatible server carrying the right --alias will do. That is
# how the GPU is reached without a code change; see README, "Running embeddings
# on a GPU". Set llama_cpp.daemon_autostart = false so cementic does not spawn
# its own CPU-only daemon alongside this one.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp packaging/systemd/cementic-*.service ~/.config/systemd/user/
#   cp packaging/systemd/cementic-*.timer   ~/.config/systemd/user/
#   # Write ~/.config/cementic/embedding.env with CEMENTIC_MODEL and
#   # CEMENTIC_ALIAS (both units read it; stating the alias once means the
#   # health probe cannot drift from the server when the fingerprint
#   # changes). CEMENTIC_ALIAS must equal the fingerprint cementic computes:
#   #   .venv/bin/python -c "from cementic.config import get_config; \
#   #     from cementic.embedding_runtime import runtime_spec_from_config, \
#   #     llama_cpp_runtime_fingerprint as f; c=get_config(); s=runtime_spec_from_config(c); \
#   #     n=s.n_ctx or c.llama_cpp.n_ctx; \
#   #     g=s.n_gpu_layers if s.n_gpu_layers is not None else c.llama_cpp.n_gpu_layers; \
#   #     print(f(model_path=s.model_identifier,n_ctx=n,n_batch=n,n_gpu_layers=g,verbose=s.verbose))"
#   systemctl --user daemon-reload
#   systemctl --user enable --now cementic-embedding.service
#
# Logs:  journalctl --user -u cementic-embedding -f

[Unit]
Description=cementic embedding server (llama.cpp, Vulkan)
After=network-online.target

[Service]
# systemd expands variables in arguments but NOT in the executable path, so
# the binary is spelled out. %h is the home directory.
# CEMENTIC_MODEL and CEMENTIC_ALIAS live in one file shared with the health
# probe; changing n_ctx/n_gpu_layers changes the fingerprint, and updating it
# in one unit but not the other made the probe post a stale model id.
EnvironmentFile=%h/.config/cementic/embedding.env
Environment=LD_LIBRARY_PATH=%h/.cache/cementic-igpu/llama-b10605
ExecStart=%h/.cache/cementic-igpu/llama-b10605/llama-server \
  --host 127.0.0.1 --port 11555 \
  --model ${CEMENTIC_MODEL} --alias ${CEMENTIC_ALIAS} \
  --embeddings --ctx-size 512 --batch-size 512 --ubatch-size 512 \
  --n-gpu-layers 99
# always, not on-failure: a suspend that invalidates the Vulkan context can end
# the process cleanly, and an unrestarted server leaves the worker waiting for
# it indefinitely. An explicit `systemctl --user stop` still stops it.
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
