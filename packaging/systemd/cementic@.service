# cementic indexing for one collection: source watcher, pipeline worker and an
# embedding wedge check, in one unit. Needs llama_cpp.daemon_autostart = true in
# the cementic config: the worker spawns the embedding server, and the unit
# restarts it by restarting itself.
#
# Install (one instance per collection; %i is the collection name):
#
#   mkdir -p ~/.config/cementic ~/.config/systemd/user
#   cat > ~/.config/cementic/papers.dirs.env <<'ENV'
#   CEMENTIC_CHECKOUT=/path/to/your/cementic/checkout
#   CEMENTIC_DIRS=/path/to/documents
#   ENV
#   cp packaging/systemd/cementic@.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cementic@papers.service
#
# CEMENTIC_DIRS is a space-separated list. Do not run this unit alongside
# `cementic start` for the same collection.
#
# The three background jobs share one restart: `wait -n` returns as soon as any
# of them ends, the unit exits, and Restart=always brings all three back. That
# is affordable because a worker restart is cheap -- it requeues anything left
# `processing` at startup, every batch is committed, and the vector upsert is
# idempotent, so at most one batch of 32 is redone.
#
# The third job is the wedge check. A llama-server that survives suspend with a
# lost GPU context keeps answering /health while the embedding call hangs, and
# cementic cannot recover from that on its own: a worker's reconnect returns
# the same client whenever /v1/models reports the expected fingerprint, which a
# wedged server still does. Breaking the loop ends the unit; the server is in
# this cgroup because the worker spawned it, so the restart replaces it too. The
# first curl is why an idle machine is left alone: the server is on demand, so a
# closed port means no embedding work, not a wedge. /embedding is llama.cpp's
# native endpoint and takes no model id, so nothing here goes stale when the
# embedding fingerprint changes. The port below is the default; change it if
# llama_cpp.port is not 11555.
#
# /bin/bash, not /bin/sh: dash has no `wait -n`.
#
# The interpreter is the checkout's .venv (its `cementic` script), not a uv-tool
# install on PATH, and that is not a style choice: the extractor fingerprint
# includes the PyMuPDF versions. A different version opens a new extractor
# profile and re-extracts every document. Check `extractor_profiles.config_json`
# before pointing CEMENTIC_CHECKOUT at another environment.
#
# A second collection is a second instance, and the two share one llama-server.
# Whichever worker started it owns it, so that instance's restart takes the
# server from the other, which recovers by autostarting a replacement -- one
# failed batch and a model reload. If that churn ever matters, run the server in
# its own unit and set daemon_autostart = false.
#
# Logs:  journalctl --user -u cementic@papers -f   (all three jobs interleaved)

[Unit]
Description=cementic indexing (%i)
# Order after the Postgres quadlet unit if you use it (see the generated
# postgres/README.md). It goes active before Postgres finishes its healthcheck,
# so this orders the start, it does not guarantee readiness: the worker logs,
# requeues its batch and backs off if it is early, and Restart=always covers the
# rest. Delete these two lines if Postgres is managed elsewhere.
After=cementic-postgres.service
Wants=cementic-postgres.service

[Service]
EnvironmentFile=%h/.config/cementic/%i.dirs.env
ExecStart=/bin/bash -c '\
  "$CEMENTIC_CHECKOUT/.venv/bin/cementic" run watcher --collection %i -- $CEMENTIC_DIRS & \
  "$CEMENTIC_CHECKOUT/.venv/bin/cementic" run worker --collection %i & \
  while sleep 300; do \
    curl -sf -m 5 -o /dev/null http://127.0.0.1:11555/health || continue; \
    curl -sf -m 90 -o /dev/null -X POST http://127.0.0.1:11555/embedding \
      -H "Content-Type: application/json" -d "{\\"content\\":\\"ping\\"}" || break; \
  done & \
  wait -n'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
